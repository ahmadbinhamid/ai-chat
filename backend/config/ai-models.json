{
  "providers": {
    "openrouter": {
      "base_url": "https://openrouter.ai/api",
      "api_key_env": "AI_API_KEY",
      "models_url": "https://openrouter.ai/api/v1/models",
      "options": { "provider": { "data_collection": "allow" } }
    }
  },
  "models": [
    {
      "id": "deepseek-pro",
      "label": "DeepSeek Pro",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-pro",
      "options": { "provider": { "order": ["azure", "parasail"], "allow_fallbacks": true } },
      "images": false,
      "thinking": true,
      "efforts": ["low"],
      "default_effort": "low"
    },
    {
      "id": "deepseek-flash",
      "label": "DeepSeek Flash",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",
      "options": { "provider": { "order": ["wafer", "deepinfra"], "allow_fallbacks": true } },
      "images": false,
      "thinking": true,
      "efforts": ["low"],
      "default_effort": "low"
    },
    {
      "id": "deepseek-flash-vision",
      "label": "DeepSeek Flash Vision",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash-vision-exp",
      "options": { "provider": { "order": ["deepinfra"], "allow_fallbacks": true } },
      "images": true,
      "thinking": true,
      "efforts": ["low"],
      "default_effort": "low",
      "selectable": false
    }
  ],
  "auto": {
    "label": "Auto",
    "design_model": "deepseek-flash", "design_effort": "low",
    "fix_model": "deepseek-pro", "fix_effort": "low"
  },
  "default_model": "auto",
  "vision_model": "deepseek-flash-vision",
  "summary_model": "deepseek-flash"
}
