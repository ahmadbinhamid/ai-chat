{
  "providers": {
    "openrouter": {
      "base_url": "https://openrouter.ai/api",
      "api_key_env": "AI_API_KEY",
      "models_url": "https://openrouter.ai/api/v1/models",
      "session_header": "x-session-id",
      "tool_choice": "any",
      "options": { "provider": { "allow_fallbacks": true, "ignore": ["cloudflare"], "data_collection": "allow" } }
    }
  },
  "models": [
    {
      "id": "deepseek-pro",
      "label": "DeepSeek Pro",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-pro",
      "options": { "provider": { "sort": "throughput" } },
      "images": false,
      "thinking": true,
      "efforts": ["low"],
      "default_effort": "low"
    },
    {
      "id": "deepseek-flash",
      "label": "DeepSeek Flash",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",
      "options": { "provider": { "sort": "throughput" } },
      "images": false,
      "thinking": true,
      "efforts": ["low"],
      "default_effort": "low"
    },
    {
      "id": "grok",
      "label": "Grok",
      "provider": "openrouter",
      "model": "x-ai/grok-4.7",
      "images": true,
      "thinking": false
    },
    {
      "id": "kimi",
      "label": "Kimi",
      "provider": "openrouter",
      "model": "moonshotai/kimi-k3",
      "images": true,
      "thinking": true,
      "efforts": ["low", "medium", "high"],
      "default_effort": "low"
    },
    {
      "id": "deepseek-flash-vision",
      "label": "DeepSeek Flash Vision",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash-vision-exp",
      "options": { "provider": { "sort": "throughput" } },
      "images": true,
      "thinking": true,
      "efforts": ["low"],
      "default_effort": "low",
      "selectable": false
    }
  ],
  "auto": {
    "label": "Auto",
    "design_model": "deepseek-flash", "design_effort": "low",
    "fix_model": "deepseek-pro", "fix_effort": "low"
  },
  "default_model": "auto",
  "vision_model": "deepseek-flash-vision",
  "summary_model": "deepseek-flash"
}
