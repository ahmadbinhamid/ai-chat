# Copy to .env and fill in — .env is gitignored, never commit real secrets.
#   cp .env.example .env

PORT=8080

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_chat
DB_USERNAME=root
DB_PASSWORD=

# --- Auth (delegated to FlowPOS — see internal/auth) ---
# Base URL of the tenant-dashboard API; every request is authenticated by
# forwarding its bearer token to GET {FLOWPOS_API_BASE}/user. No local auth
# system exists — this is required, there is no fallback. Also the base URL
# for flowpos-backend's own theme-file API (store/themes/active/files/...) —
# see internal/themefs.Store. Theme content is read/written there, not on a
# filesystem this service shares with flowpos-backend.
FLOWPOS_API_BASE=
# How long a verified (or rejected) token is trusted before re-checking with
# FlowPOS — also this service's token-revocation lag.
AUTH_CACHE_TTL_SECONDS=60
AUTH_NEGATIVE_CACHE_TTL_SECONDS=10
# Timeout for the /user introspection call itself.
FLOWPOS_HTTP_TIMEOUT_MS=2000

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=xhigh
# Claude call's max_tokens. Raise if generations fail with "truncated at the
# max_tokens limit" on complex prompts (e.g. large new pages).
ANTHROPIC_MAX_TOKENS=64000

# --- Rate limiting ---
# Max /chats/messages (generation) calls per tenant per minute — the one
# route in this service that calls an LLM and costs real money per call.
GENERATION_RATE_LIMIT_PER_MINUTE=10

# --- Redis ---
# Backs cross-replica generation-event pub/sub (see internal/modules/
# themebuild's event log and GET /api/v1/chats/:chatId/stream). Only required
# for a multi-replica deployment: with it unset, this service falls back to
# an in-process event fan-out (see themebuild's eventbus.go), which works
# fine for live delivery as long as every WebSocket connects to the same
# replica that's running the generation. Set this once you run more than one
# replica — otherwise a WebSocket on replica B never sees live events for a
# generation running on replica A.
REDIS_URL=

# --- CORS ---
# Comma-separated browser origins allowed to call this API directly (the
# tenant dashboard's own origin — it's a native page, not an iframe, so it
# calls this API straight from the browser). Empty = no cross-origin browser
# request succeeds (fails closed). Include both your local Vite dev origin
# and the deployed dashboard origin as needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173
