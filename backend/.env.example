# Copy to .env and fill in — .env is gitignored, never commit real secrets.
#   cp .env.example .env

PORT=8080

# "development" (default) or "production". In production the server refuses
# to start without AI_MODELS_CONFIG (unless AI_CHAT_FAKE_MODE is on), and
# without REDIS_URL unless AI_CHAT_SINGLE_REPLICA=true.
APP_ENV=development

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_chat
DB_USERNAME=root
DB_PASSWORD=

# --- Auth (delegated to FlowPOS — see internal/auth) ---
# Base URL of the tenant-dashboard API; every request is authenticated by
# forwarding its bearer token to GET {FLOWPOS_API_BASE}/user. No local auth
# system exists — this is required, there is no fallback. Also the base URL
# for flowpos-backend's own theme-file API (store/themes/active/files/...) —
# see internal/themefs.Store. Theme content is read/written there, not on a
# filesystem this service shares with flowpos-backend.
FLOWPOS_API_BASE=
# How long a verified (or rejected) token is trusted before re-checking with
# FlowPOS — also this service's token-revocation lag.
AUTH_CACHE_TTL_SECONDS=60
AUTH_NEGATIVE_CACHE_TTL_SECONDS=10
# Timeout for the /user introspection call itself.
FLOWPOS_HTTP_TIMEOUT_MS=2000

# --- AI effort / max tokens ---
# Reasoning effort when AI_MODELS_CONFIG is unset (with a catalogue, each
# model's efforts come from the catalogue instead). "low" measured at roughly
# half the time of "medium"; it is also the default when this is empty.
AI_EFFORT=low
# The model call's max_tokens. Raise if generations fail with "truncated at
# the max_tokens limit" on complex prompts (e.g. large new pages).
AI_MAX_TOKENS=64000

# --- AI streaming timeouts ---
# How long a single streaming attempt can go with no new event at all
# before it's treated as hung and retried, the same way a truncated/garbled
# stream chunk already is. Resets on every event the stream produces, so a
# slow-but-alive stream is never cut off by this alone. Applies only after
# the stream's first event; the first-token timeouts below cover the wait
# before that (a router queueing or prefilling sends nothing usable). A
# catalogue provider with "idle_after": "content" (OpenRouter) waits for the
# first real output instead, since OpenRouter sends its first event before the
# host has read the prompt.
AI_STREAM_IDLE_TIMEOUT_SECONDS=12
# Once a reply has started, how long it may go without any new text,
# reasoning or tool-call content before it's treated as frozen and retried.
# Keep-alive pings don't count: a host that stops generating but keeps the
# connection open would otherwise hold a turn for many minutes. Generous on
# purpose, since some hosts compose a whole tool call before sending it.
AI_STREAM_STALL_TIMEOUT_SECONDS=120
# How long a streaming attempt can go with NO real output at all (no text,
# thinking, or tool_use content) before its first byte — separate from the
# idle timeout above because a model can legitimately spend far longer
# thinking before its first token than it ever should between two
# already-flowing chunks. Split by generation mode: AI_FIRST_TOKEN_TIMEOUT_
# SECONDS is the default/fallback almost all ordinary chat traffic actually
# hits (GenerationMode is normally unset outside the explicit guided-
# onboarding flow); the NARROW budget applies to the onboarding flow's
# brand/copy modes, which are contractually narrow-scope (defaults.json
# only / hardcoded text only); the PAGES budget is longer because creating
# a new registered page is typically the most work a single turn does.
AI_FIRST_TOKEN_TIMEOUT_SECONDS=120
AI_FIRST_TOKEN_TIMEOUT_NARROW_SECONDS=45
AI_FIRST_TOKEN_TIMEOUT_PAGES_SECONDS=150

# --- AI provider (spoken over its Anthropic Messages API compat endpoint) ---
# AI_API_KEY holds the OpenRouter key: the committed catalogue's "openrouter"
# provider names it (api_key_env); keys never go in the catalogue file. To roll
# back to direct DeepSeek, copy config/ai-models.deepseek.json over
# config/ai-models.json and put the DeepSeek key here instead.
AI_API_KEY=
# AI_MODEL / AI_BASE_URL / AI_VISION_MODEL are used only when AI_MODELS_CONFIG
# is unset: they build a one-model catalogue. OpenRouter names models
# "author/model"; for direct DeepSeek use https://api.deepseek.com/anthropic
# with deepseek-v4-flash and deepseek-v4-flash-vision-exp.
AI_MODEL=deepseek/deepseek-v4-flash
AI_BASE_URL=https://openrouter.ai/api
# Model for any turn with an image attached (deepseek-v4-pro can't see images).
AI_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp

# --- AI model catalogue ---
# Path to the model catalogue merchants choose from (see config/ai-models.json,
# committed for OpenRouter; config/ai-models.deepseek.json is direct DeepSeek).
# Unset = the one-model setup above, development only: REQUIRED when
# APP_ENV=production, where the server refuses to start without it rather than
# fall back to the AI_* defaults (api.deepseek.com). The server also refuses to
# start on an invalid catalogue or a missing provider key.
# Fields per model: id (sent by the dashboard), label, provider, model (the
# provider's own name, never exposed), images, thinking, efforts,
# default_effort, selectable (default true; false hides it from the picker).
# "auto" routes fix-type turns to fix_model and the rest to design_model
# ("design_thinking": false switches thinking off on the design route only;
# effort does nothing for DeepSeek through OpenRouter, so it's the only way to
# cut a design turn's reasoning time);
# vision_model handles image turns the chosen model can't see; summary_model
# writes history summaries. Each provider names its key's env variable.
# "options" (on a provider or a model) are extra request-body fields, the
# model's deep-merged over its provider's. The OpenRouter catalogue sets no host
# "order" (that switches off OpenRouter's sticky routing); instead each chat's
# ID goes in the provider's "session_header" (x-session-id), so a chat's calls
# stay on one host and its prompt cache. "ignore" skips hosts that never cache,
# and "allow_fallbacks": true lets OpenRouter move on if the host goes down.
# A provider's "tool_choice" ("any" by default, or "auto") is what normal tool
# rounds require. "auto" lets a router use hosts that don't honour a required
# tool call. OpenRouter is on "any", since "auto" coincided with much longer
# reasoning before the first tool call, except the DeepSeek models: they use
# their own "openrouter-deepseek" entry on "auto", because for DeepSeek V4
# only DeepInfra and Azure accept "any" (and Azure breaks tool calls), which
# left each model on a single host. Forced rounds always name
# propose_changes. To use only hosts that don't store request data, set the
# openrouter provider's "data_collection" to "deny" (or add "zdr": true for
# zero data retention); off by default. A provider with "models_url" (a
# {"data":[{"id":...}]} list) has every model name checked against it at
# startup: an unlisted name stops the server; an unreachable list only warns.
# AI_MODELS_CONFIG=config/ai-models.json

# --- DeepSeek's own API (optional) ---
# Only needed with AI_MODELS_CONFIG=config/ai-models.byok.json, which sends
# DeepSeek Pro and Flash straight to DeepSeek (billed to our DeepSeek balance)
# instead of through OpenRouter; every other model stays on OpenRouter and
# AI_API_KEY. DeepSeek reports no per-call cost, so those turns' cost_usd is
# priced from the catalogue's "pricing" entries (DeepSeek's published rates).
# DEEPSEEK_API_KEY=

# --- Large themes ---
# Above either count, each model call gets a summary of the theme instead of
# all of it: pages.json as "slug — title" lines, the file tree as directory
# counts (components/, liquid/partials/, css/, js/ and this turn's files still
# listed in full), and only the components this turn's files render. The model
# can still read pages.json or list the full tree. Smaller themes get exactly
# today's prompt, so their prompt cache is unaffected.
AI_LARGE_THEME_PAGES=40
AI_LARGE_THEME_FILES=250

# --- Shutdown drain ---
# On SIGTERM/SIGINT the server stops starting generations and waits up to
# SHUTDOWN_DRAIN_SECONDS for running ones to finish, while still serving HTTP
# (new prompts just queue); then it closes HTTP, finishing in-flight requests
# for up to 15s. A generation can take several minutes, so some may still be
# cut off at the limit; those, and anything left queued, resume when their
# sender's dashboard next reaches the new process (within 10 minutes).
# The process manager's stop timeout must exceed 15 + SHUTDOWN_DRAIN_SECONDS
# plus a margin, or it kills the server mid-drain: with the default 120 that
# is at least 150s. pm2's default kill_timeout is only 1600ms; set it on the
# process (e.g. `pm2 start ./ai-chat --kill-timeout 150000`, or kill_timeout
# in an ecosystem file). Docker: `docker stop -t 150` / stop_grace_period.
SHUTDOWN_DRAIN_SECONDS=120

# --- History summarization ---
# Collapses a long chat's older turns into one cached synthetic summary turn
# instead of resending full history on every generation call (see
# themebuild.Service.summarizeOldTurnsCached). The older-turn count is
# rounded down to a block of 10 and the summary is cached per chat by that
# bucketed count, so it stays byte-identical for ~10 turns at a time and
# only re-summarizes when a block boundary is crossed (the recent window
# floats between 20 and 29 verbatim turns) — this matters most on DeepSeek,
# whose Anthropic-compat endpoint caches on request-prefix match rather than
# honoring cache_control: a summary that reworded itself every call used to
# invalidate that prefix cache for the whole conversation. Default is
# enabled for both providers now that the summary is cached; set to false to
# always resend full history verbatim instead.
HISTORY_SUMMARIZATION_ENABLED=true

# --- Placed images ---
# Largest attached image (bytes) the AI may place into the theme. FlowPOS
# stores uploads through PHP, so set this to the smaller of the FlowPOS
# server's upload_max_filesize and post_max_size. An image over it is sent
# back to the model while staging, never discovered at Apply. Default 2 MB,
# PHP's own default.
PLACED_IMAGE_MAX_BYTES=2097152

# --- Rate limiting ---
# Max /chats/messages (generation) calls per tenant per minute — the one
# route in this service that calls an LLM and costs real money per call.
GENERATION_RATE_LIMIT_PER_MINUTE=10

# --- Generation concurrency ---
# How many generations run at once in this process, overall and per tenant
# (0 = unlimited). Per replica: N replicas allow N times as many. A prompt over
# the limit stays queued (the dashboard shows it waiting) until a slot frees.
AI_MAX_CONCURRENT_GENERATIONS=8
AI_MAX_CONCURRENT_GENERATIONS_PER_TENANT=2

# --- Redis ---
# Backs cross-replica generation-event pub/sub (see internal/modules/
# themebuild's event log and GET /api/v1/chats/:chatId/stream). Only required
# for a multi-replica deployment: with it unset, this service falls back to
# an in-process event fan-out (see themebuild's eventbus.go), which works
# fine for live delivery as long as every WebSocket connects to the same
# replica that's running the generation. Set this once you run more than one
# replica — otherwise a WebSocket on replica B never sees live events for a
# generation running on replica A.
REDIS_URL=
# Production refuses to start without REDIS_URL (APP_ENV=production): the
# fallback theme lock only works inside one process, so two replicas could
# write the same theme at once. Set this to true only if exactly one replica
# will ever run.
AI_CHAT_SINGLE_REPLICA=false

# --- CORS ---
# Comma-separated browser origins allowed to call this API directly (the
# tenant dashboard's own origin — it's a native page, not an iframe, so it
# calls this API straight from the browser). Empty = no cross-origin browser
# request succeeds (fails closed). Include both your local Vite dev origin
# and the deployed dashboard origin as needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173
